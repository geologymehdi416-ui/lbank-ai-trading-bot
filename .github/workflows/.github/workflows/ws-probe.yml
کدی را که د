
name: LBank Futures WS Probe

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  websocket-probe:
    runs-on: ubuntu-latest
    timeout-minutes: 2
    steps:
      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install WebSocket client
        run: python -m pip install websockets

      - name: Read-only Futures WebSocket probe
        run: |
          python - <<'PY'
          import asyncio
          import websockets

          URL = "wss://lbkperpws.lbank.com/ws"

          async def main():
              print("Connecting to:", URL)
              try:
                  async with websockets.connect(
                      URL,
                      open_timeout=15,
                      close_timeout=5,
                      ping_interval=20,
                  ) as ws:
                      print("HANDSHAKE_OK")
                      print("Waiting up to 20 seconds.")
                      for i in range(4):
                          try:
                              msg = await asyncio.wait_for(
                                  ws.recv(), timeout=5
                              )
                              print(
                                  f"RAW_MESSAGE_{i+1}: "
                                  f"{str(msg)[:3000]}"
                              )
                          except asyncio.TimeoutError:
                              print(
                                  f"NO_MESSAGE_WITHIN_{(i+1)*5}_SECONDS"
                              )
                              break
              except Exception as exc:
                  print("CONNECTION_ERROR:", repr(exc))

          asyncio.run(main())
          PY
